# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/

# Jupyter Notebooks
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Datasets
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
# Training table the deployed model was fitted on (see models/baseline_model_metadata.json)
!data/processed/feature_table_v4.csv

# Models & Artifacts
models/*
!models/.gitkeep
# Deployed model artifact, needed by app/main.py at runtime
!models/baseline_model.joblib
!models/baseline_model_metadata.json
# Agent C's ranker and the gate result that decides whether it is allowed to
# speak. Committed together: an artifact without its gate is exactly what this
# project is trying not to ship.
!models/agent_c_variant_ranker.joblib
!models/agent_c_variant_ranker_metadata.json

# Environment & IDE
.env
.vscode/
.idea/
*.swp
*.swo

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Downloaded datasets and the extracts built from them. All regenerable with
# scripts/fetch_datasets.py, which is the record of where they came from.
data/external/cambray2018/
data/external/boel2016/
data/external/agent_c_features.csv
